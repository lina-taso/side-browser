    },
    "options-xdomainTransition-description" : {
        "message" : "If unchecked, these URLs will open in the tab.\nIf checked, transitions will occur inside Side Browser, but referers will not be set."
    },
    "options-manageHistory" : {
        "message" : "Manage history per panel."
    },
    "options-manageHistory-description-sec1-title" : {
        "message" : "When unchecked:"
    },
    "options-manageHistory-description-sec1" : {
        "message" : "Uses the browser's standard Prev/Next functionality.\nDue to browser specifications, all panels in the sidebar share a single history stack. Therefore, the Prev/Next buttons are shared across all panels.\nAdditionally, if you close a panel while navigating through the history, you may no longer be able to move forward in the history."
    },
    "options-manageHistory-description-sec2-title" : {
        "message" : "When checked:"
    },
    "options-manageHistory-description-sec2" : {
        "message" : "Side Browser manages the history independently for each panel.\nWhile this makes the Prev/Next buttons work independently per panel, pressing these buttons will cause the page to reload each time.\nOn Single Page Application (SPA)-style websites or websites that use frames, page transitions may take longer than usual or may not function properly.\nPlease also note that if you use the prev button inside the webpage itself (instead of Side Browser's Prev/Next buttons), the browser's standard page navigation will be triggered, which may cause page transitions in other panels."
    },
    "options-webrequestHeaderChangingUseragent" : {
        "message" : "Replace User-Agent header."
    },
    "options-ua" : {
        "message" : "User-Agent"
    },
    "options-enableKeyboardShortcut" : {
        "message" : "Set the keyboard shortcut for toggling the sidebar in Firefox's built-in settings."
    },
    "options-openShortcutSettings" : {
        "message" : "Open the Firefox shortcut settings page"
    },
    "options-h1-advanced" : {
        "message" : "Advanced Preference"
    },
    "options-webrequestHeaderCleaningAll" : {
        "message" : "Rewrite all response headers."
    },
    "options-webrequestHeaderCleaningAll-description-sec1-title" : {
        "message" : "Notes on \"Rewrite all response headers\""
    },
    "options-webrequestHeaderCleaningAll-description-sec1" : {
        "message" : "Side Browser uses the iframe tag so removes the X-Frame-Options header from the response to the request made within Side Browser in order to display pages that are prohibited from being embedded in frames.\nHowever some websites use service workers to retrieve pages, Side Browser can't remove the X-Frame-Options header by using normal method.\n\n"
    },
    "options-webrequestHeaderCleaningAll-description-sec2-title" : {
        "message" : "To load these websites in Side Browser:"
    },
    "options-webrequestHeaderCleaningAll-description-sec2" : {
        "message" : "Removing the service worker's X-Frame-Options response header, it is able to load these websites.\nBut since service worker communication occurs in a place unrelated to the Side Browser, removing all service workers' X-Frame-Options response headers is required.\n\n"
    },
    "options-webrequestHeaderCleaningAll-description-sec3-title" : {
        "message" : "Side Browser performs the following process to delete all service workers' X-Frame-Options response headers."
    },
    "options-webrequestHeaderCleaningAll-description-sec3" : {
        "message" : "1. Unregister all service workers at once.\n2. From now on, remove the X-Frame-Options response headers for newly created service workers.\n\n"
    },
    "options-webrequestHeaderCleaningAll-description-sec4-title" : {
        "message" : "This process has the following risks:"
    },
    "options-webrequestHeaderCleaningAll-description-sec4" : {
        "message" : "- This allows other domains' (malicious) web pages to embed pages that are prohibited from being embedded in frames.\n\n"
    },
    "options-webrequestHeaderCleaningAll-description-sec5" : {
        "message" : "If you understand this risk and want to remove response headers, check \"Rewrite all response headers\". By checking the box, the above two processes will be performed."
    },
    "options-unregister" : {
        "message" : "Run this when there are web pages that cannot be displayed, such as when Side Browser has been disabled for a while."
    },
    "options-unregister-button" : {
        "message" : "Unregister all service workers"
    },

